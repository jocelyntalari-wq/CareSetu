# ==============================================================================
# CareSetu Environment Variables Example
# Copy this file to .env and provide your credentials as needed.
# Note: Missing credentials will NOT prevent the application from working!
# CareSetu automatically uses SQLite and built-in AI/voice simulators when keys are absent.
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
SECRET_KEY=caresetu-secret-key-change-in-production

# Persistence Layer Configuration
# Options: 'sqlite' (default, zero credentials needed) or 'supabase'
STORAGE_BACKEND=sqlite

# Supabase Configuration (PostgreSQL + Auth + Storage)
# Required only if STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_BUCKET=care_documents

# Gemini API (For clinical drafting & organizing health stories)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# BHASHINI API (For Indian Language Speech-to-Text & Spoken Prompts)
# Get credentials from: https://bhashini.gov.in/
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_API_KEY=your-bhashini-ulca-api-key
BHASHINI_PIPELINE_ID=your-bhashini-pipeline-id

# Azure Document Intelligence (For medical document biomarker extraction)
# Formerly Azure Form Recognizer: https://portal.azure.com/
AZURE_DOC_INTEL_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your-azure-document-intelligence-key
